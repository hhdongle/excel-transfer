rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && uid == 'BHImPcznlFZDcrchzxzZqi8oRJd2';
    }
    function validRecord(extraKeys) {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion', 'rows', 'count', 'version', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'rows', 'count', 'version', 'createdAt', 'updatedAt'].concat(extraKeys))
        && d.schemaVersion == 1 && d.rows is list && d.rows.size() <= 1000
        && d.count == d.rows.size() && d.version is int
        && d.updatedAt == request.time;
    }
    match /users/{uid}/accountBooks/main {
      allow read: if owner(uid);
      allow create: if owner(uid) && validRecord([]) && request.resource.data.version == 1 && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validRecord([]) && request.resource.data.version == resource.data.version + 1 && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /users/{uid}/weeks/{date} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validRecord(['date']) && request.resource.data.date == date && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.version == 1 && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validRecord(['date']) && request.resource.data.date == date && request.resource.data.version == resource.data.version + 1 && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
